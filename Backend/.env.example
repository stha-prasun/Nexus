# ============================================================
# Nexus Backend — local development environment (example)
# Copy to .env:  cp .env.example .env
# Loaded by the app via dotenv; also read by `docker compose`
# for variable interpolation (keep values in sync).
# ============================================================

# --- Application ---
PORT=3000

# --- PostgreSQL (app connects through PgBouncer) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
POSTGRES_POOL_MAX=10
# Direct server port, published by docker compose for host-side
# tools (e.g. drizzle-kit migrations). Not 6432 (transaction-mode
# PgBouncer is unsafe for DDL) and not 5432 (a local PostgreSQL
# service already occupies it on this machine).
POSTGRES_HOST_PORT=5433

# --- PgBouncer (compose host port; keep in sync with POSTGRES_PORT) ---
PGBOUNCER_PORT=6432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nexus
MINIO_ROOT_PASSWORD=nexus_minio_password

# ============================================================
# Observability (all optional — defaults shown)
# ============================================================
# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info
# true = one JSON object per line (for log shippers)
LOG_JSON=false
# Per-request/dependency latency thresholds in ms (green below warn)
LATENCY_WARN_MS=500
LATENCY_ERROR_MS=2000
# Colored metrics summary interval in ms; below 1000 disables it
METRICS_INTERVAL_MS=30000
# Error rate (%) at which the metrics summary turns red
ERROR_RATE_RED_PCT=5
# Heap usage ratio (0-1) at which the metrics summary warns
HEAP_WARN_RATIO=0.9
# Colors: set NO_COLOR to disable, FORCE_COLOR=1 to force them on
# (automatic on TTY)

# --- Swagger docs (UI at /$SWAGGER_PATH, raw at /$SWAGGER_PATH-json) ---
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
